<lgc:GlassWindow x:Class="LiquidGlass.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="clr-namespace:LiquidGlass.WPF.Primitives;assembly=LiquidGlass.WPF"
        xmlns:lgc="clr-namespace:LiquidGlass.WPF.Controls;assembly=LiquidGlass.WPF"
        xmlns:lge="clr-namespace:LiquidGlass.WPF.Effects;assembly=LiquidGlass.WPF"
        Title="Liquid Glass · WPF" Width="1296" Height="804"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseSystemBackdrop="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid>

        <!-- ── 内容层（壁纸）：被标记为背景捕获源，玻璃从这里取景 ── -->
        <Grid x:Name="BackdropLayer" lge:BackdropCapture.IsSource="True">
            <Grid.Background>
                <ImageBrush ImageSource="Assets/wallpaper.jpg" Stretch="UniformToFill"/>
            </Grid.Background>
        </Grid>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="296"/>
            </Grid.ColumnDefinitions>

            <!-- ── 侧边栏 ── -->
            <lg:GlassSurface Grid.Column="0" Material="Regular" CornerRadius="24" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,2,0,18">
                        <lg:GlassSurface Width="34" Height="34" CornerRadius="17" Material="Clear">
                            <lg:SfSymbol Symbol="sparkles" Width="18" Height="18"/>
                        </lg:GlassSurface>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Liquid Glass" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="WPF 主题支持库 · v1.0" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="资料库" FontSize="11" Opacity="0.5" Margin="6,0,0,6"/>
                        <lgc:GlassButton Content="素材库" IconSymbol="photos" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Regular" Margin="0,0,0,2"/>
                        <lgc:GlassButton Content="回忆" IconSymbol="memories" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Clear" Margin="0,0,0,2"/>
                        <lgc:GlassButton Content="收藏" IconSymbol="heart" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Clear" Margin="0,0,0,2"/>
                        <lgc:GlassButton Content="播放列表" IconSymbol="sliders" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Clear" Margin="0,0,0,2"/>

                        <TextBlock Text="控件" FontSize="11" Opacity="0.5" Margin="6,16,0,6"/>
                        <lgc:GlassButton Content="主题与材质" IconSymbol="sun" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Clear" Margin="0,0,0,2"/>
                        <lgc:GlassButton Content="动画曲线" IconSymbol="bolt" Height="38" CornerRadius="10"
                                         HorizontalContentAlignment="Left" Material="Clear"/>
                    </StackPanel>

                    <lg:GlassSurface Grid.Row="2" Material="Clear" CornerRadius="14" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="iCloud 存储" FontSize="12"/>
                                <TextBlock Text="64%" FontSize="12" HorizontalAlignment="Right" Opacity="0.6"/>
                            </Grid>
                            <lgc:GlassSlider x:Name="StorageBar" Minimum="0" Maximum="100" Value="64"
                                             Height="18" Margin="0,4,0,0" IsHitTestVisible="False"/>
                        </StackPanel>
                    </lg:GlassSurface>
                </Grid>
            </lg:GlassSurface>

            <!-- ── 内容区 ── -->
            <Grid Grid.Column="1">
                <Border CornerRadius="26" ClipToBounds="True">
                    <Image Source="Assets/hero.jpg" Stretch="UniformToFill"/>
                </Border>

                <StackPanel VerticalAlignment="Bottom" Margin="30,0,0,34" HorizontalAlignment="Left">
                    <TextBlock Text="山间的清晨" FontSize="{DynamicResource LiquidGlass.Font.LargeTitle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="2026 年 10 月 4 日 · 06:12 · 吉林 · 松花湖" FontSize="12"
                               Opacity="0.72" Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <lgc:GlassChip Content="晨雾 4°C" IconSymbol="sun" Margin="0,0,8,0"/>
                        <lgc:GlassChip Content="12 张" IconSymbol="photos" Margin="0,0,8,0"/>
                        <lgc:GlassChip Content="AI 精选" IconSymbol="sparkles"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── 控制中心 ── -->
            <lgc:GlassCard Grid.Column="2" Padding="16" Margin="12,0,0,0" Material="Regular">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="控制中心" FontSize="17" FontWeight="SemiBold"/>
                        <lgc:GlassChip Content="GlassMaterial" HorizontalAlignment="Right"
                                       FontSize="10" Padding="8,3"/>
                    </Grid>

                    <TextBlock Text="渲染质量" FontSize="11" Opacity="0.55"/>
                    <lgc:GlassSegmentedControl x:Name="QualitySeg" Height="34" Margin="0,6,0,16"
                                               SelectedIndex="1"/>

                    <TextBlock Text="输出设备" FontSize="11" Opacity="0.55"/>
                    <lgc:GlassComboBox x:Name="DeviceCombo" Margin="0,6,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Studio Display"/>
                        <ComboBoxItem Content="MacBook Pro 内建"/>
                        <ComboBoxItem Content="Pro Display XDR"/>
                        <ComboBoxItem Content="AirPlay 扬声器"/>
                    </lgc:GlassComboBox>

                    <TextBlock Text="开关" FontSize="11" Opacity="0.55" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="空间音频" FontSize="13"/>
                            <TextBlock Text="头部追踪 · 自动" FontSize="10.5" Opacity="0.55"/>
                        </StackPanel>
                        <lgc:GlassToggleSwitch Grid.Column="1" x:Name="SpatialToggle" IsChecked="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="深色外观" FontSize="13"/>
                            <TextBlock Text="跟随系统" FontSize="10.5" Opacity="0.55"/>
                        </StackPanel>
                        <lgc:GlassToggleSwitch Grid.Column="1" x:Name="ThemeToggle"/>
                    </Grid>

                    <TextBlock Text="音量" FontSize="11" Opacity="0.55"/>
                    <Grid Margin="0,4,0,16">
                        <lgc:GlassSlider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="62"/>
                    </Grid>

                    <TextBlock Text="按钮层级" FontSize="11" Opacity="0.55" Margin="0,0,0,8"/>
                    <lgc:GlassButton Content="播放全部" IconSymbol="play" Material="Prominent"
                                     Height="44" CornerRadius="22" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <lgc:GlassButton Content="随机播放" IconSymbol="share" Height="36" CornerRadius="18" Margin="0,0,8,0"/>
                        <lgc:GlassButton Grid.Column="1" IconSymbol="heart" Height="36" Width="44" CornerRadius="18" Margin="0,0,8,0"/>
                        <lgc:GlassButton Grid.Column="2" IconSymbol="ellipsis" Height="36" Width="44" CornerRadius="18"/>
                    </Grid>

                    <TextBlock x:Name="SpecLine" FontFamily="Consolas" FontSize="10" Opacity="0.5"
                               Margin="0,18,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </lgc:GlassCard>
        </Grid>

        <!-- ── 悬浮胶囊标签栏 ── -->
        <lgc:GlassTabBar x:Name="TabBar" Width="512" Height="66"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,18" SelectedIndex="0">
            <lgc:GlassTabItem Title="图库" IconSymbol="photos"/>
            <lgc:GlassTabItem Title="回忆" IconSymbol="memories"/>
            <lgc:GlassTabItem Title="收藏" IconSymbol="heart"/>
            <lgc:GlassTabItem Title="列表" IconSymbol="sliders"/>
            <lgc:GlassTabItem Title="设置" IconSymbol="gear"/>
        </lgc:GlassTabBar>
    </Grid>
</lgc:GlassWindow>
