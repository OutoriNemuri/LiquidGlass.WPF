  <ItemGroup>
    <ProjectReference Include="..\..\src\LiquidGlass.WPF\LiquidGlass.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.jpg" />
  </ItemGroup>

</Project>
