<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="clr-namespace:LiquidGlass.WPF.Primitives"
    xmlns:lgc="clr-namespace:LiquidGlass.WPF.Controls"
    xmlns:lga="clr-namespace:LiquidGlass.WPF.Animation">

    <!-- ============================================================
         基础：透明按钮/开关的模板（供内部 ToggleButton、RepeatButton 使用）
         ============================================================ -->
    <ControlTemplate x:Key="LG.TransparentButton" TargetType="{x:Type ButtonBase}">
        <Border Background="Transparent" SnapsToDevicePixels="True"/>
    </ControlTemplate>

    <Style x:Key="LG.RepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassSurface：6 个渲染通道的容器（背景/透镜/色调/高光/描边/内容）
         ============================================================ -->
    <Style TargetType="{x:Type lg:GlassSurface}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="FontSize" Value="{DynamicResource LiquidGlass.Font.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lg:GlassSurface}">
                    <Grid x:Name="PART_ClipHost" Background="Transparent">
                        <!-- 用 Border + ImageBrush 而不是 Image：Image 会按位图原始像素尺寸参与测量，
                             导致每个玻璃元素被"撑大"，进而自我捕获、越滚越大。 -->
                        <Border x:Name="PART_Backdrop" IsHitTestVisible="False"/>
                        <Border x:Name="PART_Lens" IsHitTestVisible="False"/>
                        <Border x:Name="PART_Tint" IsHitTestVisible="False"/>
                        <Border x:Name="PART_Spec" IsHitTestVisible="False"/>
                        <!-- 色散：玻璃边缘的暖/冷色偏移，模拟折射 -->
                        <Border x:Name="PART_Dispersion" IsHitTestVisible="False" BorderThickness="1.4"/>
                        <Border x:Name="PART_Rim" IsHitTestVisible="False" Background="Transparent"/>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassButton
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassButton}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="FontSize" Value="{DynamicResource LiquidGlass.Font.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassButton}">
                    <lg:GlassSurface x:Name="PART_Glass"
                                     Material="{TemplateBinding Material}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="PART_Glow"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="{TemplateBinding GlowOpacity}"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,1.15" GradientOrigin="0.5,1.15"
                                                         RadiusX="0.85" RadiusY="0.9">
                                        <GradientStop Color="#8CB4E8FF" Offset="0"/>
                                        <GradientStop Color="#2E6FA8FF" Offset="0.45"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <lg:SfSymbol x:Name="PART_Icon"
                                             Symbol="{TemplateBinding IconSymbol}"
                                             Width="18" Height="18" Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Grid>
                    </lg:GlassSurface>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IconSymbol, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassToggleSwitch
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassToggleSwitch}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassToggleSwitch}">
                    <lg:GlassSurface x:Name="PART_Track" Material="Regular"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="0">
                        <Grid>
                            <Border CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{DynamicResource LiquidGlass.Brush.SystemFill}"/>
                            <Border CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{DynamicResource LiquidGlass.Brush.Accent}"
                                    Opacity="{Binding KnobProgress, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="PART_Knob" Width="24" Height="24" CornerRadius="12"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                    Background="#FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="6" ShadowDepth="1" Direction="270"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding KnobOffset, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </lg:GlassSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassSlider
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassSlider}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassSlider}">
                    <Grid Background="Transparent">
                        <Border Height="{TemplateBinding TrackHeight}" CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource LiquidGlass.Brush.SystemFill}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource LG.RepeatButton}">
                                    <Border Height="{TemplateBinding TrackHeight}" CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource LiquidGlass.Brush.Accent}"/>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource LG.RepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid>
                                                <Ellipse Fill="#FFFFFF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#0E182C" Opacity="0.30"
                                                                          BlurRadius="8" ShadowDepth="1" Direction="270"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Fill="#FFFFFF" Margin="1"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassChip
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassChip}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="FontSize" Value="{DynamicResource LiquidGlass.Font.Caption}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassChip}">
                    <lg:GlassSurface Material="{TemplateBinding Material}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lg:SfSymbol x:Name="PART_Icon" Symbol="{TemplateBinding IconSymbol}"
                                         Width="13" Height="13" Margin="0,0,5,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </lg:GlassSurface>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IconSymbol, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassTabBar / GlassTabItem
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassTabItem}">
        <!-- 不写死 Foreground：让标签跟随宿主标签栏（浅色玻璃=深色字，深色玻璃=白字） -->
        <Setter Property="Opacity" Value="0.62"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassTabItem}">
                    <Grid Background="Transparent">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <lg:SfSymbol Symbol="{TemplateBinding IconSymbol}" Width="20" Height="20"
                                         HorizontalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="{DynamicResource LiquidGlass.Font.Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type lgc:GlassTabBar}">
        <Setter Property="Height" Value="66"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassTabBar}">
                    <lg:GlassSurface Material="{TemplateBinding Material}"
                                     CornerRadius="34"
                                     Padding="5"
                                     TintBrush="{TemplateBinding TintBrush}"
                                     TintOpacity="{TemplateBinding TintOpacity}">
                        <Grid>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Width="{TemplateBinding IndicatorWidth}"
                                    CornerRadius="28"
                                    Background="#2EFFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding IndicatorOffset, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border.RenderTransform>
                            </Border>
                            <ItemsPresenter x:Name="PART_ItemsHost"/>
                        </Grid>
                    </lg:GlassSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassSegmentedControl
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassSegmentedControl}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassSegmentedControl}">
                    <lg:GlassSurface Material="Clear" CornerRadius="17" Padding="3">
                        <Grid>
                            <Border x:Name="PART_Thumb"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Width="{TemplateBinding ThumbWidth}"
                                    CornerRadius="14" Background="#FFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding ThumbOffset, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border.RenderTransform>
                            </Border>
                            <ItemsControl x:Name="PART_Items" ItemsSource="{TemplateBinding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="{DynamicResource LiquidGlass.Font.Footnote}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </lg:GlassSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassCard
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassCard}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassCard}">
                    <lg:GlassSurface Material="{TemplateBinding Material}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </lg:GlassSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GlassScrollEdgeEffect
         ============================================================ -->
    <Style TargetType="{x:Type lgc:GlassScrollEdgeEffect}">
        <Setter Property="Height" Value="64"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ============================================================
         GlassComboBox
         ============================================================ -->
    <Style x:Key="LG.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Margin="3,1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LiquidGlass.Brush.SystemFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type lgc:GlassComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource LiquidGlass.Brush.Label}"/>
        <Setter Property="FontSize" Value="{DynamicResource LiquidGlass.Font.Footnote}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource LG.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lgc:GlassComboBox}">
                    <Grid>
                        <lg:GlassSurface x:Name="PART_Root"
                                         Material="{TemplateBinding Material}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <lg:SfSymbol Grid.Column="1" Symbol="chevron-down" Width="14" Height="14"
                                             Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </lg:GlassSurface>
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      Template="{StaticResource LG.TransparentButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None"
                               Width="{TemplateBinding ActualWidth}"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <lg:GlassSurface Material="Regular" CornerRadius="14" Padding="4"
                                             Margin="0,6,0,0">
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </lg:GlassSurface>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
